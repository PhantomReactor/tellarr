}

// --- badges ---

templ statePill(state string) {
	switch state {
	case "done":
		<span class="pill pill-done"><span class="pill-dot"></span>Done</span>
	case "downloading":
		<span class="pill pill-active"><span class="pill-dot pill-dot-pulse"></span>Downloading</span>
	case "queued":
		<span class="pill pill-idle"><span class="pill-dot pill-dot-pulse"></span>Queued</span>
	case "paused":
		<span class="pill pill-paused"><span class="pill-dot"></span>Paused</span>
	case "error":
		<span class="pill pill-error"><span class="pill-dot"></span>Error</span>
	default:
		<span class="pill pill-idle"><span class="pill-dot"></span>{ state }</span>
	}
}

templ DownloadsTable(rows []DownloadRowVM) {
	<div
		id="downloads-table"
		hx-get="/ui/downloads/table"
		hx-trigger="every 2s [!document.querySelector('dialog[open]')]"
		hx-swap="outerHTML"
	>
		if len(rows) == 0 {
			<div class="empty-state">
				@iconDownload()
				<p>No downloads yet.</p>
			</div>
		} else {
			<div class="table-wrap">
				<table class="responsive downloads-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Progress</th>
							<th class="num">Size</th>
							<th class="num">Speed</th>
							<th class="num">ETA</th>
							<th>State</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr data-search={ strings.ToLower(row.Name + " " + row.Category + " " + row.Origin + " " + row.State) }>
								<td data-label="Name" class="cell-name">
									<span class="dl-name" title={ row.Name }>{ row.Name }</span>
									if row.Category != "" {
										<span class="tag">{ row.Category }</span>
									}
									<span class="tag tag-muted">{ row.Origin }</span>
									if row.Error != "" {
										<small class="dl-error">{ row.Error }</small>
									}
								</td>
								<td data-label="Progress" class="cell-progress">
									<div class="progress-row">
										<div class="progress-track"><div class={ "progress-fill", templ.KV("progress-fill-done", row.State == "done") } style={ fmt.Sprintf("width:%.1f%%", row.Percent) }></div></div>
										<small class="num">{ fmt.Sprintf("%.1f%%", row.Percent) }</small>
									</div>
								</td>
								<td data-label="Size" class="num cell-stats">
									<span>{ humanBytes(row.Written) }</span>
									<small class="muted">/ { humanBytes(row.Total) }</small>
								</td>
								<td data-label="Speed" class="num cell-stats">
									if row.State == "downloading" {
										<span class="speed">{ humanSpeed(row.Speed) }</span>
									} else {
										<span class="muted">—</span>
									}
								</td>
								<td data-label="ETA" class="num cell-stats">
									if row.State == "downloading" {
										<span>{ humanETA(row.ETA) }</span>
									} else {
										<span class="muted">—</span>
									}
								</td>
								<td data-label="State">@statePill(row.State)</td>
								<td class="actions" data-label="">
									if row.State == "downloading" || row.State == "queued" {
										<form method="post" action={ templ.URL("/ui/downloads/" + row.ID + "/pause") } class="inline-form">
											<button type="submit" class="icon-btn" title="Pause" aria-label="Pause">@iconPause()</button>
										</form>
									} else if row.State == "paused" || row.State == "error" {
										<form method="post" action={ templ.URL("/ui/downloads/" + row.ID + "/resume") } class="inline-form">
											<button type="submit" class="icon-btn icon-btn-primary" title="Resume" aria-label="Resume">@iconPlay()</button>
										</form>
									}
									<button type="button" class="icon-btn icon-btn-danger" title="Delete" aria-label="Delete" onclick="askDelete(this, event)" data-del-id={ row.ID }>@iconTrash()</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div id="downloads-table-noresults" class="empty-state" hidden>
				@iconSearch()
				<p>No downloads match your search.</p>
			</div>
		}
	</div>
}

templ DownloadsPage(rows []DownloadRowVM, msg string, errMsg string) {
	@Layout("Tellarr — Downloads", "downloads") {
		<article>
			<div class="page-head">
				<h2>Downloads</h2>
				<button type="button" class="compact-btn" onclick="openModal('modal-add-download')">@iconPlus() <span>Add download</span></button>
			</div>
			@Flash(errMsg, "error-msg")
			@Flash(msg, "ok-msg")
			if len(rows) > 0 {
				<div class="table-toolbar">
					<div class="search-box" role="search">
						@iconSearch()
						<input type="text" placeholder="Filter by name, category, source…" oninput="tellarrFilter(this)" data-target="downloads-table" aria-label="Filter downloads"/>
					</div>
				</div>
			}
			@DownloadsTable(rows)

			<dialog id="modal-add-download" class="modal">
				<div class="modal-frame">
					<header class="modal-head">
						<strong class="modal-title">Add download</strong>
						<button type="button" class="icon-btn" aria-label="Close" onclick="closeModal('modal-add-download')">@iconX()</button>
					</header>
					<form method="post" action="/ui/downloads/add">
						<label>
							Link — Telegram message, magnet, .torrent, hubcloud / gdflix / tmbcloud, telegra.ph or direct file URL
							<input type="text" name="link" placeholder="https://t.me/c/1234567/89 · magnet:?xt=urn:btih:…" required/>
						</label>
						<label>
							Save as filename <small class="muted">(optional — detected automatically when empty)</small>
							<input type="text" name="filename" placeholder="Show.S01E01.mkv"/>
						</label>
						<footer class="modal-foot">
							<button type="button" class="compact-btn outline" onclick="closeModal('modal-add-download')">Cancel</button>
							<button type="submit" class="compact-btn">@iconDownload() Start download</button>
						</footer>
					</form>
				</div>
			</dialog>

			<dialog id="modal-delete" class="modal">
				<div class="modal-frame">
					<header class="modal-head">
						<strong class="modal-title">Delete download?</strong>
						<button type="button" class="icon-btn" aria-label="Close" onclick="closeModal('modal-delete')">@iconX()</button>
					</header>
					<p class="muted modal-hint">Remove just the record, or wipe the downloaded files from disk too. This cannot be undone.</p>
					<div class="stack">
						<form method="post" action="" id="del-form-record">
							<button type="submit" class="btn-block outline">Remove record only</button>
						</form>
						<form method="post" action="" id="del-form-files">
							<button type="submit" class="btn-block btn-danger">Delete with files</button>
						</form>
					</div>
					<footer class="modal-foot">
						<button type="button" class="compact-btn outline" onclick="closeModal('modal-delete')">Cancel</button>
					</footer>
				</div>
			</dialog>
		</article>
	}
}
