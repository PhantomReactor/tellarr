package views

import (
	"fmt"
	"strings"
)

type DownloadRowVM struct {
	ID       string
	Name     string
	State    string
	Percent  float64
	Origin   string
	Category string
	Written  int64
	Total    int64
	Speed    int64
	ETA      int64 // seconds remaining; -1 when unknown
	Error    string
}

// --- formatting helpers ---

func humanBytes(n int64) string {
	if n < 1024 {
		return fmt.Sprintf("%d B", n)
	}
	units := []string{"KB", "MB", "GB", "TB", "PB"}
	val := float64(n)
	i := -1
	for val >= 1024 && i < len(units)-1 {
		val /= 1024
		i++
	}
	return fmt.Sprintf("%.1f %s", val, units[i])
}

func humanSpeed(bps int64) string {
	if bps <= 0 {
		return "—"
	}
	return humanBytes(bps) + "/s"
}

func humanETA(seconds int64) string {
	switch {
	case seconds < 0:
		return "—"
	case seconds == 0:
		return "0s"
	}
	d := seconds / 86400
	h := seconds % 86400 / 3600
	m := seconds % 3600 / 60
	s := seconds % 60
	switch {
	case d > 0:
		return fmt.Sprintf("%dd %dh", d, h)
	case h > 0:
		return fmt.Sprintf("%dh %02dm", h, m)
	case m > 0:
		return fmt.Sprintf("%dm %02ds", m, s)
	default:
		return fmt.Sprintf("%ds", s)
	}
}

// --- inline icons (feather-style, stroke inherits currentColor) ---

templ iconPause() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
}

templ iconPlay() {
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
}

