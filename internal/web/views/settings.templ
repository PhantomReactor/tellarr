package views

import "strconv"

type TokenVM struct {
	ID        int64
	Token     string
	CreatedAt string
}

type IndexerFeedVM struct {
	Name    string
	FeedURL string
}

templ SettingsPage(tokens []TokenVM, feeds []IndexerFeedVM, baseURL string, realQbURL string, qbTestResult string, maxParallel int, msg string, errMsg string) {
	@Layout("Tellarr — Settings", "settings") {
		@Flash(errMsg, "error-msg")
		@Flash(msg, "ok-msg")

		<article>
			<h2>Downloads</h2>
			<form method="post" action="/ui/settings/downloads" class="inline-form">
				<label for="max_parallel">Max parallel downloads</label>
				<input type="number" id="max_parallel" name="max_parallel" min="1" max="16" step="1" value={ strconv.Itoa(maxParallel) } style="max-width:6rem"/>
				<button type="submit" class="compact-btn">Save</button>
			</form>
		</article>

		<article>
			<h2>API keys</h2>
			<p><small class="muted">Used as the Torznab <code>apikey</code> parameter.</small></p>
		if len(tokens) > 0 {
			<div class="key-list">
				for _, t := range tokens {
					<div class="key-row">
						<code>{ t.Token }</code>
						<span class="muted key-date">{ t.CreatedAt }</span>
						<button type="button" class="icon-btn" title="Copy key" aria-label="Copy key" onclick="tellarrCopy(this)" data-copy-text={ t.Token }>@iconCopy()</button>
						<form method="post" action={ templ.URL("/ui/settings/tokens/" + strconv.FormatInt(t.ID, 10) + "/delete") } class="inline-form">
							<button type="submit" class="icon-btn icon-btn-danger" title="Delete key" aria-label="Delete key">@iconTrash()</button>
						</form>
					</div>
				}
			</div>
		} else {
			<p class="muted">No keys yet.</p>
		}
			<div class="form-center">
				<form method="post" action="/ui/settings/tokens">
					<button type="submit" class="compact-btn">@iconPlus() Generate new key</button>
				</form>
			</div>
		</article>

		<article>
			<h2>Base URL</h2>
			<p><small class="muted">Point Prowlarr/Sonarr/Radarr at this address. Channel feeds are managed on the <a href="/ui/indexers">Indexers</a> page.</small></p>
			<div class="url-fields">
				<div class="url-field">
					<span class="url-field-label">Base URL</span>
					<input type="text" readonly value={ baseURL } onclick="this.select()"/>
				</div>
			</div>
		</article>

		<article>
			<h2>Download clients</h2>
			<p>Add Tellarr as a qBittorrent client in Sonarr/Radarr:</p>
			<ul>
				<li>Host: <code>{ baseURLHost(baseURL) }</code></li>
				<li>Username / password: your <code>QBIT_USER</code>/<code>QBIT_PASS</code></li>
			</ul>
			<h3>Real qBittorrent passthrough</h3>
			if realQbURL == "" {
				<p><em><small>Not configured — set <code>QBIT_REAL_URL</code>, <code>QBIT_REAL_USER</code>, <code>QBIT_REAL_PASS</code>.</small></em></p>
			} else {
				<p>Forwarding .torrent files to: <code>{ realQbURL }</code>
					<form method="get" action="/ui/settings/qbit/test" hx-get="/ui/settings/qbit/test" hx-target="#qb-test" hx-swap="innerHTML" class="inline-form">
						<button type="submit" class="outline compact-btn">Test connection</button>
					</form>
				</p>
				<div id="qb-test">{ qbTestResult }</div>
			}
		</article>
	}
}

func baseURLHost(baseURL string) string {
	for _, prefix := range []string{"https://", "http://"} {
		if len(baseURL) > len(prefix) && baseURL[:len(prefix)] == prefix {
			return baseURL[len(prefix):]
		}
	}
	return baseURL
}
