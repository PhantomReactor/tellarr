package views

templ authBrand() {
	<div class="auth-brand">
		<span class="brand-mark">@iconLogo()</span>
	</div>
}

templ LoginPage(errMsg string, canRegister bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tellarr — Login</title>
			<meta name="theme-color" content="#121316"/>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='4' fill='%23e0a458'/%3E%3Cpath d='M6.5 8h11M12 8v9.5' fill='none' stroke='%23fff' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ "/static/pico.css?v=" + AssetVersion }/>
			<link rel="stylesheet" href={ "/static/custom.css?v=" + AssetVersion }/>
		</head>
		<body>
			<main class="container">
				<article class="auth-card">
					@authBrand()
					<h2>Sign in to Tellarr</h2>
					@Flash(errMsg, "error-msg")
					<form method="post" action="/ui/login">
						<input type="text" name="username" placeholder="Username" autocomplete="username" required/>
						<input type="password" name="password" placeholder="Password" autocomplete="current-password" required/>
						<button type="submit">Login</button>
					</form>
					if canRegister {
						<p class="muted auth-alt">No account? <a href="/ui/register">Register</a></p>
					}
				</article>
			</main>
		</body>
	</html>
}

templ RegisterPage(errMsg string, canRegister bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tellarr — Register</title>
			<meta name="theme-color" content="#121316"/>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='4' fill='%23e0a458'/%3E%3Cpath d='M6.5 8h11M12 8v9.5' fill='none' stroke='%23fff' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ "/static/pico.css?v=" + AssetVersion }/>
			<link rel="stylesheet" href={ "/static/custom.css?v=" + AssetVersion }/>
		</head>
		<body>
			<main class="container">
				<article class="auth-card">
					@authBrand()
					<h2>Create account</h2>
					@Flash(errMsg, "error-msg")
					if canRegister {
						<form method="post" action="/ui/register">
							<input type="text" name="username" placeholder="Username" autocomplete="username" required/>
							<input type="password" name="password" placeholder="Password" autocomplete="new-password" required/>
							<button type="submit">Register</button>
						</form>
					} else {
						<p><mark>Registration is closed</mark> — Tellarr is single-user.</p>
					}
					<p class="muted auth-alt">Have an account? <a href="/ui/login">Login</a></p>
				</article>
			</main>
		</body>
	</html>
}
