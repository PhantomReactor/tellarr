package views

import "strconv"

templ TelegramPage(step string, sessionId int64, msg string, errMsg string) {
	@Layout("Tellarr — Telegram", "telegram") {
		<article>
			<h2>Connect Telegram</h2>
			<p>Log in with your Telegram account to use its channels as indexers.</p>
			@Flash(errMsg, "error-msg")
			@Flash(msg, "ok-msg")

			if step == "phone" {
				<form method="post" action="/ui/telegram/phone">
					<label for="phone">Phone number (international format)</label>
					<input type="tel" id="phone" name="phone" placeholder="+15551234567" required/>
					<button type="submit">Send code</button>
				</form>
			} else if step == "code" {
				<form method="post" action="/ui/telegram/code">
					<input type="hidden" name="sessionId" value={ strconv.FormatInt(sessionId, 10) }/>
					<label for="code">Login code sent by Telegram</label>
					<input type="text" id="code" name="code" placeholder="12345" required/>
					<button type="submit">Verify code</button>
				</form>
			} else if step == "password" {
				<form method="post" action="/ui/telegram/password">
					<input type="hidden" name="sessionId" value={ strconv.FormatInt(sessionId, 10) }/>
					<label for="password">Two-factor password</label>
					<input type="password" id="password" name="password" autocomplete="current-password" required/>
					<button type="submit">Unlock</button>
				</form>
			} else if step == "done" {
				<p>✅ Telegram connected.</p>
				<a href="/ui/indexers"><button>Pick indexer channels →</button></a>
			}
		</article>
	}
}
