package views

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/pico.css"/>
			<link rel="stylesheet" href="/static/custom.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<main class="container">
				<nav>
					<ul>
						<li><strong>Tellarr</strong></li>
					</ul>
					<ul>
						<li><a href="/ui/telegram" class={ templ.KV("active", active == "telegram") }>Telegram</a></li>
						<li><a href="/ui/indexers" class={ templ.KV("active", active == "indexers") }>Indexers</a></li>
						<li><a href="/ui/downloads" class={ templ.KV("active", active == "downloads") }>Downloads</a></li>
						<li><a href="/ui/settings" class={ templ.KV("active", active == "settings") }>Settings</a></li>
						<li>
							<form method="post" action="/ui/logout" class="inline-form">
								<button type="submit" class="outline small-btn">Logout</button>
							</form>
						</li>
					</ul>
				</nav>
				{ children... }
			</main>
		</body>
	</html>
}

templ Flash(msg string, kind string) {
	if msg != "" {
		<article class={ kind }><p>{ msg }</p></article>
	}
}
